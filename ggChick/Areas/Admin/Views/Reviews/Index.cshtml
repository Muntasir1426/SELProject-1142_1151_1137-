@model IEnumerable<ggChick.Models.Review>
@{
    ViewData["Title"] = "Customer Reviews Moderation";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Customer Reviews</h2>
        <p class="text-secondary small mb-0">Moderate ratings, comments, and customer feedback</p>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden" style="background-color: var(--bg-surface);">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light small">
                <tr>
                    <th class="ps-4">Product</th>
                    <th>User</th>
                    <th>Rating</th>
                    <th>Review Content</th>
                    <th>Date</th>
                    <th class="text-end pe-4">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var rev in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <span class="fw-bold small text-truncate d-block" style="max-width: 180px;">
                                @(rev.Product?.Name ?? "Item")
                            </span>
                        </td>
                        <td class="small">@(rev.User?.FullName ?? "Customer")</td>
                        <td>
                            <div class="d-flex text-warning small">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="bi @(i <= rev.Rating ? "bi-star-fill" : "bi-star text-muted")"></i>
                                }
                            </div>
                        </td>
                        <td class="small text-secondary" style="max-width: 320px;">
                            @rev.Comment
                        </td>
                        <td class="small text-muted">@rev.CreatedAt.ToString("MMM dd, yyyy")</td>
                        <td class="text-end pe-4">
                            <form asp-action="Delete" asp-route-id="@rev.Id" method="post" onsubmit="return confirm('Permanently remove this review?');" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Review">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
