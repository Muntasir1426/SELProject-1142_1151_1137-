@model IEnumerable<ggChick.Areas.Admin.Controllers.UserRowViewModel>
@{
    ViewData["Title"] = "Registered Users";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Registered Users</h2>
        <p class="text-secondary small mb-0">System user accounts, assigned roles, and order counts</p>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden" style="background-color: var(--bg-surface);">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light small">
                <tr>
                    <th class="ps-4">Full Name</th>
                    <th>Username</th>
                    <th>Email Address</th>
                    <th>Role(s)</th>
                    <th>Orders</th>
                    <th class="text-end pe-4">Joined Date</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model)
                {
                    <tr>
                        <td class="ps-4 fw-bold">
                            <i class="bi bi-person-circle me-1 text-primary"></i> @row.User.FullName
                        </td>
                        <td class="small"><code>@@@row.User.UserName</code></td>
                        <td class="small">@row.User.Email</td>
                        <td>
                            @foreach (var r in row.Roles)
                            {
                                <span class="badge @(r == "Admin" ? "bg-danger" : "bg-primary") me-1">@r</span>
                            }
                        </td>
                        <td class="small">
                            <span class="badge bg-light text-dark border">@row.User.Orders.Count Orders</span>
                        </td>
                        <td class="text-end pe-4 small text-muted">@row.User.CreatedAt.ToString("MMM dd, yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
