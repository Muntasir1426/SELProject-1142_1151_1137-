@model ggChick.Models.Order
@{
    ViewData["Title"] = "Manage Order #" + Model.Id;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Manage Order #@Model.Id</h2>
        <p class="text-secondary small mb-0">Customer order placed on @Model.OrderDate.ToString("MMMM dd, yyyy h:mm tt")</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-custom btn-sm rounded-pill">
        <i class="bi bi-arrow-left me-1"></i> Back to Orders
    </a>
</div>

<div class="row g-4">
    <!-- Left: Order Items Table -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4" style="background-color: var(--bg-surface);">
            <div class="card-header bg-light py-3">
                <h6 class="mb-0 fw-bold">Ordered Products (@Model.OrderItems.Count items)</h6>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th class="ps-4">Product</th>
                            <th>Unit Price</th>
                            <th>Quantity</th>
                            <th class="text-end pe-4">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderItems)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="@(item.Product?.MainImageUrl ?? "/images/placeholder.svg")" class="rounded border" style="width: 45px; height: 45px; object-fit: cover;" alt="" />
                                        <div>
                                            <h6 class="mb-0 small fw-bold">@(item.Product?.Name ?? "Product Item")</h6>
                                            <small class="text-muted">Item ID: @item.ProductId</small>
                                        </div>
                                    </div>
                                </td>
                                <td class="small">৳@item.UnitPrice.ToString("F2")</td>
                                <td class="small">@item.Quantity</td>
                                <td class="text-end pe-4 fw-bold small text-primary">৳@item.Subtotal.ToString("F2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Right: Status Update & Customer Info -->
    <div class="col-lg-4">
        <!-- Update Status Card -->
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4" style="background-color: var(--bg-surface);">
            <h6 class="fw-bold mb-3"><i class="bi bi-arrow-clockwise me-1 text-primary"></i> Order Status Management</h6>

            <form asp-action="UpdateStatus" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Current Status:</label>
                    <select name="status" class="form-select">
                        @foreach (var status in Enum.GetValues<ggChick.Models.Enums.OrderStatus>())
                        {
                            <option value="@status" selected="@(Model.Status == status)">@status</option>
                        }
                    </select>
                </div>

                <button type="submit" class="btn btn-primary-custom w-100 rounded-pill">
                    Update Order Status
                </button>
            </form>
        </div>

        <!-- Customer & Delivery Card -->
        <div class="card border-0 shadow-sm rounded-4 p-4" style="background-color: var(--bg-surface);">
            <h6 class="fw-bold mb-3"><i class="bi bi-person me-1 text-primary"></i> Customer Details</h6>
            <p class="small mb-1"><strong>Name:</strong> @(Model.User?.FullName ?? "Customer")</p>
            <p class="small mb-2"><strong>Email:</strong> @(Model.User?.Email ?? "No email")</p>
            <p class="small mb-2"><strong>Phone:</strong> @(Model.PhoneNumber ?? "None provided")</p>
            <hr class="my-2">
            <h6 class="fw-bold small mb-1">Shipping Address:</h6>
            <p class="small text-secondary mb-3">@Model.ShippingAddress</p>

            <div class="d-flex justify-content-between pt-2 border-top">
                <span class="fw-bold">Total Paid:</span>
                <span class="fw-bold text-primary fs-5">৳@Model.TotalAmount.ToString("F2")</span>
            </div>
        </div>
    </div>
</div>
