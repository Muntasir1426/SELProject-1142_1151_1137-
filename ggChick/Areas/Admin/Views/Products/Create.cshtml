@model ggChick.ViewModels.Products.ProductCreateEditViewModel
@{
    ViewData["Title"] = "Add New Product";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-lg-5" style="background-color: var(--bg-surface);">
            <div class="mb-4">
                <h3 class="fw-bold mb-1">Add New Product</h3>
                <p class="text-secondary small">Fill in the details to publish a new product in the store</p>
            </div>

            <form asp-action="Create" method="post" enctype="multipart/form-data" novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="row g-3 mb-3">
                    <!-- Product Name -->
                    <div class="col-md-8">
                        <label asp-for="Name" class="form-label small fw-semibold"></label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Ultra Gaming Headset" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <!-- Category -->
                    <div class="col-md-4">
                        <label asp-for="CategoryId" class="form-label small fw-semibold"></label>
                        <select asp-for="CategoryId" asp-items="Model.CategoriesList" class="form-select">
                            <option value="">-- Choose Category --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <!-- Price -->
                    <div class="col-md-6">
                        <label asp-for="Price" class="form-label small fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text">৳</span>
                            <input asp-for="Price" type="number" step="0.01" class="form-control" placeholder="0.00" />
                        </div>
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>

                    <!-- Stock Quantity -->
                    <div class="col-md-6">
                        <label asp-for="StockQuantity" class="form-label small fw-semibold"></label>
                        <input asp-for="StockQuantity" type="number" class="form-control" placeholder="Quantity in units" />
                        <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Description -->
                <div class="mb-3">
                    <label asp-for="Description" class="form-label small fw-semibold"></label>
                    <textarea asp-for="Description" class="form-control" rows="4" placeholder="Comprehensive product specifications and benefits"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <!-- Main Image Upload & Preview -->
                <div class="card bg-light border-0 rounded-3 p-3 mb-3">
                    <label class="form-label small fw-bold mb-1">Main Product Image (Cover)</label>
                    <p class="text-secondary small mb-2">Upload a high-resolution image (.jpg, .png, .webp, max 5MB).</p>
                    <input type="file" asp-for="MainImageFile" class="form-control" id="mainImageInput" accept=".jpg,.jpeg,.png,.webp" />
                    <span asp-validation-for="MainImageFile" class="text-danger small"></span>
                    <div id="mainImagePreview"></div>
                </div>

                <!-- Multiple Additional Images Upload -->
                <div class="card bg-light border-0 rounded-3 p-3 mb-4">
                    <label class="form-label small fw-bold mb-1">Additional Gallery Images</label>
                    <p class="text-secondary small mb-2">Select multiple images to create a product gallery carousel.</p>
                    <input type="file" asp-for="AdditionalImageFiles" class="form-control" id="additionalImagesInput" multiple accept=".jpg,.jpeg,.png,.webp" />
                    <span asp-validation-for="AdditionalImageFiles" class="text-danger small"></span>
                    <div id="additionalImagesPreview" class="image-preview-container"></div>
                </div>

                <!-- Active Status -->
                <div class="form-check mb-4">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveCheck" />
                    <label class="form-check-label small fw-semibold" for="isActiveCheck">
                        Publish Product Immediately (Visible to customers)
                    </label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary-custom rounded-pill px-4">
                        <i class="bi bi-cloud-arrow-up me-1"></i> Create Product
                    </button>
                    <a asp-action="Index" class="btn btn-outline-custom rounded-pill">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
