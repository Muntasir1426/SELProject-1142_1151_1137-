@model ggChick.ViewModels.Products.ProductCreateEditViewModel
@{
    ViewData["Title"] = "Edit Product: " + Model.Name;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-lg-5" style="background-color: var(--bg-surface);">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h3 class="fw-bold mb-1">Edit Product</h3>
                    <p class="text-secondary small mb-0">Update inventory details, pricing, and images</p>
                </div>
                <a asp-action="Index" class="btn btn-outline-custom btn-sm rounded-pill">
                    <i class="bi bi-arrow-left me-1"></i> Back to Products
                </a>
            </div>

            <form asp-action="Edit" method="post" enctype="multipart/form-data" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="MainImageUrl" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="row g-3 mb-3">
                    <div class="col-md-8">
                        <label asp-for="Name" class="form-label small fw-semibold"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="CategoryId" class="form-label small fw-semibold"></label>
                        <select asp-for="CategoryId" asp-items="Model.CategoriesList" class="form-select"></select>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Price" class="form-label small fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text">৳</span>
                            <input asp-for="Price" type="number" step="0.01" class="form-control" />
                        </div>
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="StockQuantity" class="form-label small fw-semibold"></label>
                        <input asp-for="StockQuantity" type="number" class="form-control" />
                        <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label small fw-semibold"></label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <!-- Main Image Preview and Replace -->
                <div class="card bg-light border-0 rounded-3 p-3 mb-3">
                    <label class="form-label small fw-bold mb-1">Main Cover Image</label>
                    @if (!string.IsNullOrEmpty(Model.MainImageUrl))
                    {
                        <div class="mb-2">
                            <img src="@Model.MainImageUrl" alt="Current Cover" class="rounded border" style="width: 80px; height: 80px; object-fit: cover;" />
                            <small class="text-muted ms-2">Current Cover Image</small>
                        </div>
                    }
                    <label class="small text-secondary">Replace Cover Image:</label>
                    <input type="file" asp-for="MainImageFile" class="form-control" id="mainImageInput" accept=".jpg,.jpeg,.png,.webp" />
                    <div id="mainImagePreview"></div>
                </div>

                <!-- Existing Gallery Images with Delete Buttons -->
                @if (Model.ExistingImages.Any())
                {
                    <div class="card bg-light border-0 rounded-3 p-3 mb-3">
                        <label class="form-label small fw-bold mb-2">Existing Gallery Images</label>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var img in Model.ExistingImages)
                            {
                                <div class="position-relative border rounded p-1 bg-white" style="width: 85px; height: 85px;">
                                    <img src="@img.ImageUrl" style="width: 100%; height: 100%; object-fit: cover;" class="rounded" alt="" />
                                    <button type="submit" formaction="@Url.Action("DeleteImage", new { imageId = img.Id, productId = Model.Id })" formmethod="post" class="preview-remove-btn" title="Delete Image" onclick="return confirm('Delete this image?');">
                                        &times;
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Add More Gallery Images -->
                <div class="card bg-light border-0 rounded-3 p-3 mb-4">
                    <label class="form-label small fw-bold mb-1">Upload Additional Images</label>
                    <input type="file" asp-for="AdditionalImageFiles" class="form-control" id="additionalImagesInput" multiple accept=".jpg,.jpeg,.png,.webp" />
                    <div id="additionalImagesPreview" class="image-preview-container"></div>
                </div>

                <!-- Active Toggle -->
                <div class="form-check mb-4">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveCheck" />
                    <label class="form-check-label small fw-semibold" for="isActiveCheck">
                        Product is Active &amp; Visible in Store
                    </label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary-custom rounded-pill px-4">
                        <i class="bi bi-save me-1"></i> Save Changes
                    </button>
                    <a asp-action="Index" class="btn btn-outline-custom rounded-pill">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
