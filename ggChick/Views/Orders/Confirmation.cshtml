@model ggChick.Models.Order
@{
    ViewData["Title"] = "Order Confirmation #" + Model.Id;
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 p-5 text-start" style="background-color: var(--bg-surface);">
                <div class="text-center mb-4">
                    <span class="badge bg-success-subtle text-success p-3 rounded-circle mb-3">
                        <i class="bi bi-check2-circle fs-1"></i>
                    </span>
                    <h3 class="fw-bold mb-1">Thank You for Your Order!</h3>
                    <p class="text-secondary small">Your order has been received and is being processed.</p>
                </div>

                <div class="bg-light rounded-3 p-3 mb-4 d-flex justify-content-between flex-wrap gap-2 small">
                    <div>
                        <span class="text-muted d-block">Order Number:</span>
                        <strong>#GGCLIKS-@Model.Id</strong>
                    </div>
                    <div>
                        <span class="text-muted d-block">Date Placed:</span>
                        <strong>@Model.OrderDate.ToString("MMM dd, yyyy h:mm tt")</strong>
                    </div>
                    <div>
                        <span class="text-muted d-block">Status:</span>
                        <span class="badge bg-warning text-dark">@Model.Status</span>
                    </div>
                    <div>
                        <span class="text-muted d-block">Total Amount:</span>
                        <strong class="text-primary">৳@Model.TotalAmount.ToString("F2")</strong>
                    </div>
                </div>

                <h6 class="fw-bold mb-3">Items Ordered</h6>
                <div class="table-responsive mb-4">
                    <table class="table align-middle small mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Product</th>
                                <th>Qty</th>
                                <th>Price</th>
                                <th class="text-end">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.OrderItems)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <img src="@(item.Product?.MainImageUrl ?? "/images/placeholder.svg")" class="rounded border" style="width: 35px; height: 35px; object-fit: cover;" alt="" />
                                            <span>@(item.Product?.Name ?? "Product Item")</span>
                                        </div>
                                    </td>
                                    <td>@item.Quantity</td>
                                    <td>৳@item.UnitPrice.ToString("F2")</td>
                                    <td class="text-end fw-semibold">৳@item.Subtotal.ToString("F2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="border-top pt-3 mb-4 small text-secondary">
                    <h6 class="fw-bold text-dark mb-1">Delivery Address:</h6>
                    <p class="mb-1">@Model.ShippingAddress</p>
                    @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                    {
                        <p class="mb-0">Contact Phone: @Model.PhoneNumber</p>
                    }
                </div>

                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Orders" asp-action="Index" class="btn btn-outline-custom rounded-pill">
                        <i class="bi bi-box-seam me-1"></i> View My Orders
                    </a>
                    <a asp-controller="Products" asp-action="Index" class="btn btn-primary-custom rounded-pill">
                        <i class="bi bi-bag me-1"></i> Continue Shopping
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
