@model IEnumerable<ggChick.Models.Order>
@{
    ViewData["Title"] = "My Orders";
}

<div class="container py-4">
    <div class="mb-4 pb-2 border-bottom">
        <h2 class="fw-bold mb-1">My Orders</h2>
        <p class="text-secondary small mb-0">Track and view your past purchases and delivery statuses.</p>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center my-4" style="background-color: var(--bg-surface);">
            <div class="mb-3">
                <span class="badge bg-light text-secondary p-3 rounded-circle fs-1">
                    <i class="bi bi-box-seam"></i>
                </span>
            </div>
            <h4 class="fw-bold mb-2">No Orders Yet</h4>
            <p class="text-secondary small mb-4">You have not placed any orders with GGCLIKS yet.</p>
            <div>
                <a asp-controller="Products" asp-action="Index" class="btn btn-primary-custom rounded-pill px-4">
                    Start Shopping
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden" style="background-color: var(--bg-surface);">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="ps-4">Order #</th>
                            <th scope="col">Date</th>
                            <th scope="col">Items</th>
                            <th scope="col">Total</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="text-end pe-4">Details</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">#@order.Id</td>
                                <td class="small">@order.OrderDate.ToString("MMM dd, yyyy")</td>
                                <td class="small">@order.OrderItems.Sum(oi => oi.Quantity) items</td>
                                <td class="fw-bold text-primary">৳@order.TotalAmount.ToString("F2")</td>
                                <td>
                                    @switch (order.Status)
                                    {
                                        case ggChick.Models.Enums.OrderStatus.Pending:
                                            <span class="badge bg-warning text-dark">Pending</span>
                                            break;
                                        case ggChick.Models.Enums.OrderStatus.Processing:
                                            <span class="badge bg-info text-dark">Processing</span>
                                            break;
                                        case ggChick.Models.Enums.OrderStatus.Shipped:
                                            <span class="badge bg-primary">Shipped</span>
                                            break;
                                        case ggChick.Models.Enums.OrderStatus.Delivered:
                                            <span class="badge bg-success">Delivered</span>
                                            break;
                                        case ggChick.Models.Enums.OrderStatus.Cancelled:
                                            <span class="badge bg-danger">Cancelled</span>
                                            break;
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-custom rounded-pill">
                                        View Order
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
