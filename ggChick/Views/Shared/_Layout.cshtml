@inject ggChick.Services.ICartService CartService
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GGCLIKS E-Commerce</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CSS & Bootstrap Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Application CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/chatbot.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-custom py-2">
            <div class="container">
                <!-- Brand Logo -->
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <span class="badge bg-primary p-2 rounded-3"><i class="bi bi-bag-check-fill text-white fs-5"></i></span>
                    <span class="brand-logo">GGCLIKS</span>
                </a>

                <!-- Mobile Toggle -->
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <!-- Nav Links -->
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 fw-medium">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door me-1"></i> Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Products" asp-action="Index"><i class="bi bi-grid me-1"></i> Shop Catalog</a>
                        </li>
                    </ul>

                    <!-- Search Bar -->
                    <form class="d-flex mx-lg-3 my-2 my-lg-0 flex-grow-1" style="max-width: 420px;" asp-controller="Products" asp-action="Index" method="get">
                        <div class="input-group">
                            <input class="form-control bg-light border-end-0 rounded-start-pill ps-3" type="search" name="search" placeholder="Search t-shirts, cardigans, hoodies, pants..." value="@Context.Request.Query["search"]" aria-label="Search">
                            <button class="btn btn-light border-start-0 rounded-end-pill pe-3 text-primary" type="submit">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                    </form>

                    <!-- Right Controls (Cart, Theme, Auth) -->
                    <ul class="navbar-nav align-items-lg-center gap-2 mb-2 mb-lg-0">
                        <!-- Theme Toggle Button -->
                        <li class="nav-item">
                            <button class="btn btn-outline-secondary border-0 rounded-circle p-2" id="themeToggleBtn" title="Toggle Dark/Light Mode" aria-label="Toggle Theme">
                                <i class="bi bi-moon-stars-fill" id="themeIcon"></i>
                            </button>
                        </li>

                        <!-- Shopping Cart -->
                        <li class="nav-item">
                            <a class="btn btn-outline-custom position-relative rounded-pill px-3" asp-controller="Cart" asp-action="Index">
                                <i class="bi bi-cart3 me-1"></i> Cart
                                @{
                                    var cartCount = CartService.GetCartCount();
                                }
                                <span class="badge bg-danger rounded-pill ms-1 @(cartCount == 0 ? "d-none" : "")" id="cartBadge">
                                    @cartCount
                                </span>
                            </a>
                        </li>

                        <!-- Authentication Section -->
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center gap-2 text-primary fw-semibold" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle fs-5"></i>
                                    <span>@User.Identity.Name</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3">
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li>
                                            <a class="dropdown-item fw-semibold text-danger" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                                <i class="bi bi-speedometer2 me-2"></i> Admin Dashboard
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                    }
                                    <li>
                                        <a class="dropdown-item" asp-controller="Orders" asp-action="Index">
                                            <i class="bi bi-box-seam me-2"></i> My Orders
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-custom rounded-pill px-3" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary-custom rounded-pill px-3" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus me-1"></i> Register
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Global Alert Banners -->
    <div class="container mt-3">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3 d-flex align-items-center" role="alert">
                <i class="bi bi-check-circle-fill fs-5 me-2"></i>
                <div>@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-3 d-flex align-items-center" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i>
                <div>@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <!-- Main Page Body -->
    <main role="main" class="pb-4">
        @RenderBody()
    </main>

    <!-- Floating Chatbot Widget -->
    <partial name="_ChatbotPartial" />

    <!-- Modern Footer -->
    <footer class="footer-custom">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="badge bg-primary p-2 rounded-3"><i class="bi bi-bag-check-fill text-white fs-5"></i></span>
                        <span class="brand-logo fs-4">GGCLIKS</span>
                    </div>
                    <p class="text-secondary small mb-3">
                        Your trusted modern destination for premium streetwear, cozy cardigans, heavyweight hoodies, vintage t-shirts, and tailored pants.
                    </p>
                    <div class="d-flex gap-2">
                        <span class="badge bg-light text-dark border p-2"><i class="bi bi-shield-check text-success me-1"></i> Secure Checkout</span>
                        <span class="badge bg-light text-dark border p-2"><i class="bi bi-truck text-primary me-1"></i> Free Shipping >৳100</span>
                    </div>
                </div>
                <div class="col-6 col-lg-2">
                    <h6 class="fw-bold mb-3">Quick Links</h6>
                    <ul class="list-unstyled text-secondary small d-flex flex-column gap-2">
                        <li><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-secondary">Home</a></li>
                        <li><a asp-controller="Products" asp-action="Index" class="text-decoration-none text-secondary">All Products</a></li>
                        <li><a asp-controller="Cart" asp-action="Index" class="text-decoration-none text-secondary">My Shopping Cart</a></li>
                        <li><a asp-controller="Orders" asp-action="Index" class="text-decoration-none text-secondary">Order History</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-3">
                    <h6 class="fw-bold mb-3">Customer Support</h6>
                    <ul class="list-unstyled text-secondary small d-flex flex-column gap-2">
                        <li><span class="text-secondary"><i class="bi bi-envelope me-1"></i> support@ggcliks.com</span></li>
                        <li><span class="text-secondary"><i class="bi bi-telephone me-1"></i> +1 (800) 555-GGCLIK</span></li>
                        <li><span class="text-secondary"><i class="bi bi-robot me-1"></i> 24/7 Gemini AI Assistant</span></li>
                        <li><a asp-controller="Home" asp-action="Privacy" class="text-decoration-none text-secondary">Privacy & Terms</a></li>
                    </ul>
                </div>
                <div class="col-lg-3">
                    <h6 class="fw-bold mb-3">Stay Connected</h6>
                    <p class="text-secondary small">Subscribe for early product drop notifications and exclusive discounts.</p>
                    <div class="input-group input-group-sm">
                        <input type="email" class="form-control" placeholder="Enter your email" aria-label="Email">
                        <button class="btn btn-primary-custom" type="button">Join</button>
                    </div>
                </div>
            </div>
            <hr class="my-4 border-secondary opacity-25">
            <div class="d-flex flex-wrap justify-content-between align-items-center small text-secondary">
                <div>&copy; @DateTime.UtcNow.Year GGCLIKS E-Commerce Platform. CSE Software Engineering Project.</div>
                <div class="d-flex gap-3">
                    <a asp-controller="Home" asp-action="Privacy" class="text-secondary text-decoration-none">Privacy Policy</a>
                    <a asp-controller="Home" asp-action="Index" class="text-secondary text-decoration-none">Terms of Service</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5, jQuery & Site Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/chatbot.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
