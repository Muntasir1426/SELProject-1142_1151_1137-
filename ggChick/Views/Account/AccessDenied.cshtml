@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-lg rounded-4 p-5" style="background-color: var(--bg-surface);">
                <span class="badge bg-danger-subtle text-danger p-3 rounded-circle mb-3 mx-auto" style="width: fit-content;">
                    <i class="bi bi-shield-x fs-1"></i>
                </span>
                <h3 class="fw-bold mb-2">Access Denied</h3>
                <p class="text-secondary mb-4">
                    You do not have the required permissions to access this administrative resource.
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-custom">Return Home</a>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary-custom">Sign in as Administrator</a>
                </div>
            </div>
        </div>
    </div>
</div>
