@model ggChick.ViewModels.Account.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 p-4 p-sm-5" style="background-color: var(--bg-surface);">
                <div class="text-center mb-4">
                    <span class="badge bg-warning-subtle text-warning p-2 rounded-circle mb-2">
                        <i class="bi bi-question-circle-fill fs-3"></i>
                    </span>
                    <h3 class="fw-bold">Password Recovery</h3>
                    <p class="text-secondary small">Enter your email address to receive password reset instructions.</p>
                </div>

                <form asp-action="ForgotPassword" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="mb-4">
                        <label asp-for="Email" class="form-label small fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control border-start-0" placeholder="e.g. name@example.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary-custom w-100 py-2 rounded-3">
                        <i class="bi bi-send me-1"></i> Send Reset Link
                    </button>
                </form>

                <div class="text-center mt-4 pt-2 border-top">
                    <a asp-action="Login" class="text-secondary small text-decoration-none"><i class="bi bi-arrow-left me-1"></i> Back to Sign In</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
