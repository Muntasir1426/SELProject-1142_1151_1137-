@{
    ViewData["Title"] = "Password Reset Instructions";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card border-0 shadow-lg rounded-4 p-4 p-sm-5 text-center" style="background-color: var(--bg-surface);">
                <div class="mb-3">
                    <span class="badge bg-success-subtle text-success p-3 rounded-circle">
                        <i class="bi bi-envelope-check-fill fs-2"></i>
                    </span>
                </div>
                <h4 class="fw-bold mb-2">Check Your Email</h4>
                <p class="text-secondary small mb-4">
                    If an account is associated with that email, instructions to reset your password have been generated.
                </p>

                @if (ViewBag.ResetLink != null)
                {
                    <div class="alert alert-warning text-start small mb-4">
                        <strong>Developer / Demo Reset Link:</strong><br />
                        <span class="text-muted">Because this is running in a local environment, you can reset immediately using this link:</span>
                        <div class="mt-2 text-break">
                            <a href="@ViewBag.ResetLink" class="btn btn-sm btn-outline-primary">Reset Password Now</a>
                        </div>
                    </div>
                }

                <a asp-action="Login" class="btn btn-outline-custom">Return to Sign In</a>
            </div>
        </div>
    </div>
</div>
