@model ggChick.ViewModels.Cart.CartViewModel
@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold mb-1">Shopping Cart</h2>
            <p class="text-secondary small mb-0">Review your selected items before proceeding to checkout.</p>
        </div>
        @if (Model.Items.Any())
        {
            <form asp-action="Clear" method="post" onsubmit="return confirm('Clear all items from your cart?');">
                <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill">
                    <i class="bi bi-trash me-1"></i> Clear Cart
                </button>
            </form>
        }
    </div>

    @if (!Model.Items.Any())
    {
        <!-- Empty Cart -->
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center my-4" style="background-color: var(--bg-surface);">
            <div class="mb-3">
                <span class="badge bg-light text-secondary p-4 rounded-circle fs-1">
                    <i class="bi bi-cart-x"></i>
                </span>
            </div>
            <h4 class="fw-bold mb-2">Your Cart is Empty</h4>
            <p class="text-secondary small mb-4">Looks like you haven't added any items to your shopping cart yet.</p>
            <div>
                <a asp-controller="Products" asp-action="Index" class="btn btn-primary-custom rounded-pill px-4">
                    <i class="bi bi-arrow-left me-1"></i> Start Shopping
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- Left: Cart Items Table -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden" style="background-color: var(--bg-surface);">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" class="ps-4">Product</th>
                                    <th scope="col">Price</th>
                                    <th scope="col" style="width: 140px;">Quantity</th>
                                    <th scope="col">Subtotal</th>
                                    <th scope="col" class="text-end pe-4">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center gap-3">
                                                <img src="@(item.ImageUrl ?? "/images/placeholder.svg")" alt="@item.ProductName" class="rounded-3 border" style="width: 55px; height: 55px; object-fit: cover;" />
                                                <div>
                                                    <h6 class="mb-0 fw-bold small">
                                                        <a asp-controller="Products" asp-action="Details" asp-route-id="@item.ProductId" class="text-decoration-none text-reset">
                                                            @item.ProductName
                                                        </a>
                                                    </h6>
                                                    <small class="text-muted">Stock: @item.StockQuantity available</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="fw-semibold">৳@item.UnitPrice.ToString("F2")</td>
                                        <td>
                                            <form asp-action="UpdateQuantity" method="post" class="d-flex align-items-center gap-1">
                                                <input type="hidden" name="productId" value="@item.ProductId" />
                                                <button type="button" class="btn btn-sm btn-outline-secondary px-2 py-0" onclick="const i = this.nextElementSibling; if(i.value > 1) { i.value--; this.form.submit(); }">-</button>
                                                <input type="number" name="quantity" value="@item.Quantity" min="1" max="@item.StockQuantity" class="form-control form-control-sm text-center px-1" style="width: 48px;" onchange="this.form.submit()" />
                                                <button type="button" class="btn btn-sm btn-outline-secondary px-2 py-0" onclick="const i = this.previousElementSibling; if(i.value < @item.StockQuantity) { i.value++; this.form.submit(); }">+</button>
                                            </form>
                                        </td>
                                        <td class="fw-bold text-primary">৳@item.Subtotal.ToString("F2")</td>
                                        <td class="text-end pe-4">
                                            <form asp-action="Remove" method="post">
                                                <input type="hidden" name="productId" value="@item.ProductId" />
                                                <button type="submit" class="btn btn-link text-danger p-0 border-0" title="Remove from cart">
                                                    <i class="bi bi-trash fs-5"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="mt-3">
                    <a asp-controller="Products" asp-action="Index" class="btn btn-outline-custom btn-sm rounded-pill">
                        <i class="bi bi-arrow-left me-1"></i> Continue Shopping
                    </a>
                </div>
            </div>

            <!-- Right: Order Summary -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 p-4" style="background-color: var(--bg-surface);">
                    <h5 class="fw-bold mb-3">Order Summary</h5>

                    <div class="d-flex justify-content-between mb-2 small">
                        <span class="text-secondary">Subtotal (@Model.TotalItemCount items)</span>
                        <span class="fw-semibold">৳@Model.Subtotal.ToString("F2")</span>
                    </div>

                    <div class="d-flex justify-content-between mb-2 small">
                        <span class="text-secondary">Estimated Tax (5%)</span>
                        <span class="fw-semibold">৳@Model.EstimatedTax.ToString("F2")</span>
                    </div>

                    <div class="d-flex justify-content-between mb-3 small">
                        <span class="text-secondary">Shipping</span>
                        <span class="fw-semibold @(Model.ShippingFee == 0 ? "text-success" : "")">
                            @(Model.ShippingFee == 0 ? "FREE" : "৳" + Model.ShippingFee.ToString("F2"))
                        </span>
                    </div>

                    @if (Model.Subtotal < 100)
                    {
                        <div class="alert alert-info py-2 small mb-3">
                            <i class="bi bi-info-circle me-1"></i> Add <strong>৳@((1000 - Model.Subtotal).ToString("F2"))</strong> more to qualify for <strong>FREE Shipping!</strong>
                        </div>
                    }

                    <hr class="my-3">

                    <div class="d-flex justify-content-between mb-4">
                        <span class="fw-bold fs-5">Total</span>
                        <span class="fw-bold fs-5 text-primary">৳@Model.GrandTotal.ToString("F2")</span>
                    </div>

                    <a asp-controller="Orders" asp-action="Checkout" class="btn btn-primary-custom w-100 py-2 fs-6 rounded-pill">
                        <i class="bi bi-credit-card me-2"></i> Proceed to Checkout
                    </a>
                </div>
            </div>
        </div>
    }
</div>
